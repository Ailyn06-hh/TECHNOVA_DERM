# Configuración de variables de entorno para Technova-Derm (XAMPP local)
# Copia este archivo como .env.local

# URL base de la aplicación web (para enlaces en correos)
APP_URL=http://localhost:3000

# Base de datos MySQL / MariaDB en XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=technova_derm

# URL del backend central (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Configuración SMTP para envío de correos (Nodemailer)
# Si se dejan vacíos, el sistema imprimirá los códigos y enlaces en la consola en modo desarrollo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Technova-Derm <no-reply@technovaderm.com>"

# Proveedor de Pagos ('simulado' por defecto en desarrollo, o 'mercadopago')
# REGLA DE SEGURIDAD: Nunca ingresar tarjetas reales en desarrollo.
PAGOS_PROVEEDOR=simulado

# Credenciales de Mercado Pago (Sandbox) - Solo requeridas si PAGOS_PROVEEDOR=mercadopago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

